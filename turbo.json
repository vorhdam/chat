{
  "$schema": "https://v2-10-9.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "REDIS_URL",
    "DATABASE_URL",
    "JWT_SECRET",
    "TF_VAR_AWS_REGION",
    "TF_VAR_DOMAIN_NAME",
    "TF_VAR_ROUTE53_ZONE_ID",
    "AWS_SES_KEY_ID",
    "AWS_SES_KEY_SECRET",
    "AWS_SES_CONFIG_SET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "dependsOn": ["db:generate"],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:studio": {
      "persistent": true,
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:pull": {
      "cache": false
    }
  }
}
