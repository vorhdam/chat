{
  "name": "@repo/database",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "bun --env-file=../../.env run prisma generate",
    "db:migrate": "bun --env-file=../../.env run prisma migrate dev",
    "db:studio": "bun --env-file=../../.env run prisma studio",
    "db:push": "bun --env-file=../../.env run prisma db push",
    "db:pull": "bun --env-file=../../.env run prisma db pull"
  },
  "devDependencies": {
    "@repo/eslint": "*",
    "@repo/typescript": "*",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "prisma": "^7.9.1",
    "server-only": "^0.0.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.23.0"
  }
}
