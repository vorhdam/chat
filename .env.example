# Node Environment
# The current work environment of the application.
## You can set this to "development" or "production"
NODE_ENV = "development"

# Database URL
# The URL of the database to be used by the application.
## You can get a connection string from your cloud provider.
DATABASE_URL = "postgresql://username:password@localhost:5432"

# Redis Secrets
# The details of the Redis database for caching and ratelimiting.
## You can get a connection string from your cloud provider.
REDIS_URL = "redis://username:password@localhost:13005"

# JWT Secret
# This (HS256) key is used to sign credential Json Web Tokens.
## You can generate a secret using OpenSSL: openssl rand -base64 32 (this was generated for this example)
JWT_SECRET = "roOPnVo0cP+C53vzCowNtYHa63kj7aaO4x9c8b/pz1k="

# AWS Region
# The region where the AWS infrastructure is based in.
## This depends on your prefered AWS location or what is closest to you.
TF_VAR_AWS_REGION = "eu-central-1"

# AWS Domain Name
# The domain for the application that AWS can use.
## The domain you want AWS to have access to.
TF_VAR_DOMAIN_NAME = "example.com"

# AWS Zone ID
# The ID of the hosted zone in Route 53.
## You can find this at: https://console.aws.amazon.com/route53/v2/hostedzones
TF_VAR_ROUTE53_ZONE_ID = "Z0000000000000EXAMPLE"

# AWS SES Access Key ID
# This is the SES user ID that is responsible for sending emails.
## You can generate this using: bun infra:output (see in package.json)
AWS_SES_KEY_ID = "ABC0000000000EXAMPLE"

# AWS SES Access Key Secret
# This is the SES user secret that is responsible for sending emails.
## You can generate this using: bun infra:output (see in package.json)
AWS_SES_KEY_SECRET = "ABC00000000000000000000000000000EXAMPLE"

# AWS SES Config Set name
# This is the config set for the mail infrastructure.
AWS_SES_CONFIG_SET = "ses-config-dev"