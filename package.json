{
  "name": "chat",
  "private": true,
  "scripts": {
    "build": "bun --bun turbo run build",
    "dev": "bun --bun turbo run dev",
    "start": "bun --bun turbo run start",
    "lint": "bun --bun turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "bun --bun turbo run check-types",
    "db:generate": "bun --bun turbo run db:generate",
    "db:migrate": "bun --bun turbo run db:migrate",
    "db:studio": "bun --bun turbo run db:studio",
    "db:push": "bun --bun turbo run db:push",
    "db:pull": "bun --bun turbo run db:pull",
    "infra:init": "terraform -chdir=infra/environments/dev init",
    "infra:validate": "terraform -chdir=infra/environments/dev validate",
    "infra:plan": "bun run --env-file=.env -- terraform -chdir=infra/environments/dev plan",
    "infra:apply": "bun run --env-file=.env -- terraform -chdir=infra/environments/dev apply",
    "infra:destroy": "terraform -chdir=infra/environments/dev destroy",
    "infra:output": "terraform -chdir=infra/environments/dev output -json",
    "package:build": "turbo run package:build",
    "package:dev": "turbo run package:dev",
    "package:login": "bun x npm login",
    "package:change": "changeset",
    "package:version": "changeset version",
    "package:release": "turbo build && changeset publish",
    "registry:build": "bun --bun turbo run registry:build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.6",
    "tsup": "^9.0.0",
    "turbo": "^2.10.12",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/*"
  ]
}
