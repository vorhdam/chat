{
  "name": "chat",
  "private": true,
  "scripts": {
    "build": "bun --bun turbo run build",
    "dev": "bun --bun turbo run dev",
    "lint": "bun --bun turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "bun --bun turbo run check-types",
    "db:generate": "bun --bun turbo run db:generate",
    "db:migrate": "bun --bun turbo run db:migrate",
    "db:studio": "bun --bun turbo run db:studio",
    "db:push": "bun --bun turbo run db:push",
    "db:pull": "bun --bun turbo run db:pull",
    "infra:init": "cd infra/environments/dev && terraform init",
    "infra:validate": "cd infra/environments/dev && terraform validate",
    "infra:plan": "cd infra/environments/dev && terraform plan",
    "infra:apply": "cd infra/environments/dev && terraform apply",
    "infra:destroy": "cd infra/environments/dev && terraform destroy",
    "infra:output": "cd infra/environments/dev && terraform output -json"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/*"
  ]
}
